@* Compact Kanban card for one job application *@

<div class="kanban-card @(App.IsNoResponse ? "kanban-card--no-response" : "") @(IsDragging ? "kanban-card--dragging" : "")"
     draggable="true"
     @ondragstart="OnDragStart"
     @ondragend="OnDragEnd">

    @* ── No-response warning banner ── *@
    @if (App.IsNoResponse)
    {
        <div class="kanban-card__no-response-bar">
            <i class="bi bi-clock me-1"></i>Awaiting reply · @App.DaysSinceLastActivity days
        </div>
    }

    @* ── Header: Title + actions ── *@
    <div class="kanban-card__header">
        <a href="/applications/@App.Id" class="kanban-card__title">@App.JobTitle</a>
        <div class="kanban-card__actions dropdown">
            <button class="kanban-card__menu-btn" data-bs-toggle="dropdown" aria-expanded="false"
                    @onclick:stopPropagation="true">
                <i class="bi bi-three-dots-vertical"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" style="min-width:160px;font-size:0.82rem">
                <li><a class="dropdown-item" href="/applications/@App.Id">
                    <i class="bi bi-eye me-2"></i>View
                </a></li>
                <li><a class="dropdown-item" href="/applications/@App.Id/edit">
                    <i class="bi bi-pencil me-2"></i>Edit
                </a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <span class="dropdown-item-text text-muted small px-3">Move to stage</span>
                </li>
                @foreach (var stage in ApplicationWorkflow.Stages.Where(s => s != App.Stage))
                {
                    var s = stage;
                    <li>
                        <button class="dropdown-item" @onclick="() => MoveToStage(s)"
                                @onclick:stopPropagation="true">
                            @EnumHelper.DisplayName(s)
                        </button>
                    </li>
                }
            </ul>
        </div>
    </div>

    @if (App.Stage == ApplicationStage.NoResponse)
    {
        <div class="small text-muted mb-1">Manually marked · No Response</div>
    }

    @* ── Company ── *@
    <div class="kanban-card__company">
        @if (!string.IsNullOrWhiteSpace(App.RecruitingCompany))
        {
            <span class="text-muted">@App.RecruitingCompany</span>
            @if (!string.IsNullOrWhiteSpace(App.ClientCompany)) { <span class="text-muted"> › </span> }
        }
        <span>@App.ClientCompany</span>
    </div>

    @* ── Location + Work Mode ── *@
    @if (App.City is not null || App.Country is not null)
    {
        <div class="kanban-card__location">
            <i class="bi bi-geo-alt me-1"></i>
            @App.City@(App.City is not null && App.Country is not null ? ", " : "")@App.Country
            <span class="ms-1 badge bg-light text-dark border" style="font-size:0.65rem">
                @EnumHelper.DisplayName(App.WorkMode)
            </span>
        </div>
    }

    @* ── Match score ── *@
    @if (MatchResult is not null && MatchResult.HasRequirements)
    {
        <div class="mt-1">
            <JobMatchBadge Result="MatchResult" />
        </div>
    }

    @* ── Tech tags (max 4) ── *@
    @if (App.TechnologyRequirements.Count > 0)
    {
        <div class="kanban-card__tags mt-1">
            @foreach (var req in App.TechnologyRequirements
                .OrderByDescending(r => r.RequirementLevel)
                .Take(4))
            {
                <TechBadge Technology="@req.Technology.Name" />
            }
            @if (App.TechnologyRequirements.Count > 4)
            {
                <span class="badge bg-light text-muted border" style="font-size:0.65rem">
                    +@(App.TechnologyRequirements.Count - 4)
                </span>
            }
        </div>
    }

    @* ── Footer ── *@
    <div class="kanban-card__footer mt-2">
        @* Priority *@
        <span class="@EnumHelper.BadgeClass(App.Priority)" style="font-size:0.65rem" title="Interest Level">
            @EnumHelper.DisplayName(App.Priority)
        </span>

        @* Next interview *@
        @{
            var nextInterview = App.Interviews
                .Where(i => i.Status == InterviewStatus.Scheduled
                         && i.ScheduledDate.HasValue
                         && i.ScheduledDate.Value >= DateTime.UtcNow)
                .OrderBy(i => i.ScheduledDate)
                .FirstOrDefault();
        }
        @if (nextInterview is not null)
        {
            <span class="badge bg-primary" style="font-size:0.65rem">
                <i class="bi bi-calendar-check me-1"></i>@nextInterview.ScheduledDate?.ToString("MMM d")
            </span>
        }

        @* Last activity *@
        @if (!App.IsTerminalStage)
        {
            <span class="text-muted" style="font-size:0.7rem">
                @(App.DaysSinceLastActivity == 0 ? "Updated today" : App.DaysSinceLastActivity == 1 ? "1 day without response" : $"{App.DaysSinceLastActivity} days without response")
            </span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public JobApplication App       { get; set; } = null!;
    [Parameter] public JobMatchResult?               MatchResult { get; set; }
    [Parameter] public EventCallback OnDragEnded { get; set; }
    [Parameter] public EventCallback<int>            OnDragStarted { get; set; }
    [Parameter] public EventCallback<ApplicationStage> OnStageMoved { get; set; }

    private bool IsDragging { get; set; }

    private async Task OnDragStart(DragEventArgs e)
    {
        IsDragging = true;
        await OnDragStarted.InvokeAsync(App.Id);
    }

    private async Task OnDragEnd(DragEventArgs e)
    {
        IsDragging = false;
        await OnDragEnded.InvokeAsync();
    }

    private async Task MoveToStage(ApplicationStage stage)
        => await OnStageMoved.InvokeAsync(stage);
}
