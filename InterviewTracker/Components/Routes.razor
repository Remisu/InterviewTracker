<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="new[] { typeof(InterviewTracker.Client._Imports).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(InterviewTracker.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not Found</PageTitle>
        <LayoutView Layout="typeof(InterviewTracker.Components.Layout.MainLayout)">
            <div class="container mt-5">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Page not found.
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
