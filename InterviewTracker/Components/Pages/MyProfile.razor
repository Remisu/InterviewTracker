@page "/profile"
@inject ProfileService ProfileSvc
@inject TechnologyService TechService

<PageTitle>My Profile</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-person-circle me-2"></i>My Profile</h1>
    <button class="btn btn-primary btn-sm" @onclick="OpenAdd">
        <i class="bi bi-plus-lg me-1"></i>Add Technology
    </button>
</div>

@* ── Add / Edit form ── *@
@if (_formVisible)
{
    <div class="it-card mb-3 border border-primary">
        <h6 class="fw-bold mb-3">@(_editEntry?.Id > 0 ? "Edit Entry" : "Add Technology to Profile")</h6>
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Technology *</label>
                <select class="form-select form-select-sm" @bind="_formTechId">
                    <option value="0">— Select technology —</option>
                    @foreach (var tech in _availableTechs)
                    {
                        <option value="@tech.Id">@tech.Name (@EnumHelper.DisplayName(tech.Category))</option>
                    }
                </select>
                @if (_formError is not null)
                {
                    <div class="text-danger small">@_formError</div>
                }
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Years</label>
                <input type="number" class="form-control form-control-sm" min="0" max="50" step="0.5"
                       @bind="_formYears" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Skill Level</label>
                <select class="form-select form-select-sm" @bind="_formSkill">
                    @foreach (var s in EnumHelper.AllSkillLevels())
                    {
                        <option value="@s">@EnumHelper.DisplayName(s)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Last Used Year</label>
                <input type="number" class="form-control form-control-sm" min="2000" max="@DateTime.UtcNow.Year"
                       @bind="_formLastYear" />
            </div>
        </div>
        <div class="row g-2 mt-1">
            <div class="col-md-8">
                <label class="form-label small fw-semibold">Notes</label>
                <input type="text" class="form-control form-control-sm" @bind="_formNotes" />
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary btn-sm" @onclick="SaveEntryAsync">
                <i class="bi bi-check-lg me-1"></i>Save
            </button>
            <button class="btn btn-secondary btn-sm" @onclick="CloseForm">Cancel</button>
        </div>
    </div>
}

@* ── Profile list grouped by category ── *@
@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (_profile.Count == 0)
{
    <div class="it-card text-center text-muted py-4">
        <i class="bi bi-person-lines-fill display-6 d-block mb-2"></i>
        Your profile is empty. Add technologies to enable match scoring.
    </div>
}
else
{
    @foreach (var group in _profile.GroupBy(p => p.Technology.Category).OrderBy(g => g.Key))
    {
        <div class="it-card mb-3">
            <h6 class="text-muted fw-bold small mb-3 text-uppercase tracking-wide">
                @EnumHelper.DisplayName(group.Key)
            </h6>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Technology</th>
                            <th class="text-center">Years</th>
                            <th>Skill Level</th>
                            <th class="text-center">Last Used</th>
                            <th>Notes</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in group.OrderBy(e => e.Technology.Name))
                        {
                            <tr>
                                <td class="fw-semibold">@entry.Technology.Name</td>
                                <td class="text-center">@entry.YearsExperience</td>
                                <td>
                                    <span class="badge @SkillBadge(entry.SkillLevel)">
                                        @EnumHelper.DisplayName(entry.SkillLevel)
                                    </span>
                                </td>
                                <td class="text-center text-muted small">@entry.LastUsedYear</td>
                                <td class="small text-muted">@entry.Notes</td>
                                <td class="text-end">
                                    <button class="btn btn-link btn-sm p-0 me-2" title="Edit"
                                            @onclick="() => OpenEdit(entry)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-link btn-sm p-0 text-danger" title="Remove"
                                            @onclick="() => AskDelete(entry)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<ConfirmDialog Visible="_deleteVisible"
               Title="Remove Technology"
               Message=@($"Remove '{_deleteTarget?.Technology?.Name}' from your profile?")
               ConfirmLabel="Remove"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="() => _deleteVisible = false" />

@code {
    private List<ProfileTechnology> _profile = [];
    private List<Technology> _availableTechs = [];
    private bool _loading = true;

    // Form state
    private bool _formVisible;
    private ProfileTechnology? _editEntry;
    private int _formTechId;
    private decimal _formYears;
    private SkillLevel _formSkill = SkillLevel.Intermediate;
    private int? _formLastYear;
    private string? _formNotes;
    private string? _formError;

    // Delete
    private bool _deleteVisible;
    private ProfileTechnology? _deleteTarget;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _profile = await ProfileSvc.GetAllAsync();
        var allTechs = await TechService.GetAllAsync();
        var inProfile = _profile.Select(p => p.TechnologyId).ToHashSet();
        _availableTechs = allTechs.Where(t => !inProfile.Contains(t.Id)).ToList();
        _loading = false;
    }

    private void OpenAdd()
    {
        _editEntry = null;
        _formTechId = 0;
        _formYears = 0;
        _formSkill = SkillLevel.Intermediate;
        _formLastYear = DateTime.UtcNow.Year;
        _formNotes = null;
        _formError = null;
        _formVisible = true;
    }

    private void OpenEdit(ProfileTechnology entry)
    {
        _editEntry = entry;
        _formTechId = entry.TechnologyId;
        _formYears = entry.YearsExperience;
        _formSkill = entry.SkillLevel;
        _formLastYear = entry.LastUsedYear;
        _formNotes = entry.Notes;
        _formError = null;
        _formVisible = true;
    }

    private void CloseForm()
    {
        _formVisible = false;
        _formError = null;
    }

    private async Task SaveEntryAsync()
    {
        _formError = null;

        if (_editEntry is null && _formTechId == 0)
        {
            _formError = "Please select a technology.";
            return;
        }

        var entry = new ProfileTechnology
        {
            Id              = _editEntry?.Id ?? 0,
            TechnologyId    = _editEntry?.TechnologyId ?? _formTechId,
            YearsExperience = _formYears,
            SkillLevel      = _formSkill,
            LastUsedYear    = _formLastYear,
            Notes           = _formNotes
        };

        await ProfileSvc.UpsertAsync(entry);
        CloseForm();
        await LoadAsync();
    }

    private void AskDelete(ProfileTechnology entry)
    {
        _deleteTarget = entry;
        _deleteVisible = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null) return;
        await ProfileSvc.DeleteAsync(_deleteTarget.Id);
        _deleteVisible = false;
        _deleteTarget = null;
        await LoadAsync();
    }

    private static string SkillBadge(SkillLevel level) => level switch
    {
        SkillLevel.Beginner     => "bg-secondary",
        SkillLevel.Basic        => "bg-info text-dark",
        SkillLevel.Intermediate => "bg-primary",
        SkillLevel.Advanced     => "bg-warning text-dark",
        SkillLevel.Expert       => "bg-success",
        _                       => "bg-secondary"
    };
}
