@page "/"
@inject ApplicationService AppService
@inject JobMatchService MatchService

<PageTitle>Dashboard — Interview Tracker</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-speedometer2 me-2"></i>Dashboard</h1>
    <a href="/applications/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>New Application
    </a>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else
{
    @* ── Stat cards ── *@
    <div class="row g-3 mb-4">
        <StatCard Title="Total Applications" Value="@_all.Count.ToString()"      Icon="bi-file-earmark-text" Color="primary" />
        <StatCard Title="Active"             Value="@_active.ToString()"          Icon="bi-activity"          Color="success" />
        <StatCard Title="This Month"         Value="@_thisMonth.ToString()"       Icon="bi-calendar-month"    Color="info" />
        <StatCard Title="Interviews"         Value="@_interviewCount.ToString()"  Icon="bi-calendar-check"    Color="warning" />
        <StatCard Title="Offers"             Value="@_offers.ToString()"          Icon="bi-trophy"            Color="success" />
        <StatCard Title="Rejected"           Value="@_rejected.ToString()"        Icon="bi-x-circle"          Color="danger" />
        <StatCard Title="No Response"        Value="@_noResponse.ToString()"      Icon="bi-clock-history"     Color="secondary" />
        <StatCard Title="Avg Match"          Value="@(_avgMatch.HasValue ? $"{_avgMatch}%" : "—")" Icon="bi-graph-up" Color="primary" />
    </div>

    <div class="row g-3">
        @* ── Recent applications ── *@
        <div class="col-md-7">
            <div class="it-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0">Recent Applications</h6>
                    <a href="/applications" class="small text-decoration-none">View all</a>
                </div>
                @if (_all.Count == 0)
                {
                    <p class="text-muted small text-center py-4">
                        <i class="bi bi-inbox d-block display-6 mb-2"></i>
                        No applications yet. <a href="/applications/new">Add your first one.</a>
                    </p>
                }
                else
                {
                    @foreach (var app in _all.Take(8))
                    {
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                            <div>
                                <a href="/applications/@app.Id" class="fw-semibold text-decoration-none small">
                                    @app.JobTitle
                                </a>
                                <div class="text-muted" style="font-size:0.75rem">
                                    @app.ClientCompany
                                    @if (app.City is not null)
                                    {
                                        <span> · @app.City</span>
                                    }
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="@EnumHelper.BadgeClass(app.IsNoResponse ? ApplicationStage.NoResponse : app.Stage)"
                                      style="font-size:0.7rem">
                                    @(app.IsNoResponse ? "No Response" : EnumHelper.DisplayName(app.Stage))
                                </span>
                                <span class="@EnumHelper.BadgeClass(app.Priority)" style="font-size:0.7rem">
                                    @EnumHelper.DisplayName(app.Priority)
                                </span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* ── By Stage ── *@
        <div class="col-md-5">
            <div class="it-card h-100">
                <h6 class="fw-bold mb-3">Applications by Stage</h6>
                @if (_all.Count == 0)
                {
                    <p class="text-muted small text-center py-4">No data yet.</p>
                }
                else
                {
                    @foreach (var group in _all
                        .GroupBy(a => a.IsNoResponse ? ApplicationStage.NoResponse : a.Stage)
                        .OrderByDescending(g => g.Count()))
                    {
                        var pct = (int)((group.Count() / (double)_all.Count) * 100);
                        <div class="mb-2">
                            <div class="d-flex justify-content-between" style="font-size:0.82rem">
                                <span>@EnumHelper.DisplayName(group.Key)</span>
                                <span class="fw-semibold">@group.Count()</span>
                            </div>
                            <div class="progress" style="height:5px">
                                <div class="progress-bar" style="width:@(pct)%"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* ── Follow-ups due ── *@
    @if (_followUps.Count > 0)
    {
        <div class="it-card mt-3">
            <h6 class="fw-bold mb-3">
                <i class="bi bi-bell me-2 text-warning"></i>Follow-ups Required
            </h6>
            @foreach (var app in _followUps)
            {
                var daysUntil = (int)(app.NextFollowUpDate!.Value.Date - DateTime.UtcNow.Date).TotalDays;
                <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                    <div>
                        <a href="/applications/@app.Id" class="fw-semibold text-decoration-none small">
                            @app.JobTitle
                        </a>
                        <span class="text-muted small ms-2">@app.ClientCompany</span>
                    </div>
                    <span class="badge @(daysUntil < 0 ? "bg-danger" : "bg-warning text-dark")">
                        @if (daysUntil < 0)
                        {
                            <span>@(-daysUntil)d overdue</span>
                        }
                        else if (daysUntil == 0)
                        {
                            <span>Today</span>
                        }
                        else
                        {
                            <span>In @daysUntil d</span>
                        }
                    </span>
                </div>
            }
        </div>
    }

    @* ── Upcoming interviews ── *@
    @if (_upcomingInterviews.Count > 0)
    {
        <div class="it-card mt-3">
            <h6 class="fw-bold mb-3">
                <i class="bi bi-calendar-check me-2 text-primary"></i>Upcoming Interviews
            </h6>
            @foreach (var (app, interview) in _upcomingInterviews)
            {
                <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                    <div>
                        <a href="/applications/@app.Id" class="fw-semibold text-decoration-none small">
                            @app.JobTitle
                        </a>
                        <span class="text-muted small ms-2">@app.ClientCompany</span>
                        <span class="badge bg-light text-dark border ms-2" style="font-size:0.7rem">
                            @EnumHelper.DisplayName(interview.InterviewType)
                        </span>
                    </div>
                    <span class="text-primary fw-semibold small">
                        @interview.ScheduledDate?.ToString("MMM d, HH:mm")
                    </span>
                </div>
            }
        </div>
    }
}

@code {
    private List<JobApplication> _all = [];
    private int _active, _thisMonth, _interviewCount, _offers, _rejected, _noResponse;
    private int? _avgMatch;
    private List<JobApplication> _followUps = [];
    private List<(JobApplication App, Interview Interview)> _upcomingInterviews = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _all = await AppService.GetAllAsync();

        _active         = _all.Count(a => !a.IsTerminalStage);
        _thisMonth      = _all.Count(a => a.AppliedDate.HasValue
                              && a.AppliedDate.Value.Year == DateTime.UtcNow.Year
                              && a.AppliedDate.Value.Month == DateTime.UtcNow.Month);
        _interviewCount = _all.Sum(a => a.Interviews.Count);
        _offers         = _all.Count(a => a.Stage is ApplicationStage.Offer or ApplicationStage.Accepted);
        _rejected       = _all.Count(a => a.Stage == ApplicationStage.Rejected);
        _noResponse     = _all.Count(a => a.IsNoResponse);

        // Batch match calculation
        if (_all.Count > 0)
        {
            var matchScores = await MatchService.CalculateBatchAsync(_all);
            var scored = matchScores.Values.Where(r => r.HasRequirements).ToList();
            _avgMatch = scored.Count > 0 ? (int)Math.Round(scored.Average(r => r.Score)) : null;
        }

        _followUps = _all
            .Where(a => a.NextFollowUpDate.HasValue
                     && a.NextFollowUpDate.Value.Date <= DateTime.UtcNow.Date)
            .OrderBy(a => a.NextFollowUpDate)
            .ToList();

        _upcomingInterviews = _all
            .SelectMany(a => a.Interviews
                .Where(i => i.Status == InterviewStatus.Scheduled
                         && i.ScheduledDate.HasValue
                         && i.ScheduledDate.Value >= DateTime.UtcNow)
                .Select(i => (App: a, Interview: i)))
            .OrderBy(x => x.Interview.ScheduledDate)
            .Take(5)
            .ToList();

        _loading = false;
    }
}
